# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# NextAuth - Autenticación con Google
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-un-secret-con-openssl-rand-base64-32

# Google OAuth - Obtener de Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# Configuración de la aplicación
NEXT_PUBLIC_APP_NAME=Club Tesoros
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AWS S3 - Para almacenamiento de imágenes
AWS_ACCESS_KEY_ID=tu-access-key
AWS_SECRET_ACCESS_KEY=tu-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=tu-bucket-name
