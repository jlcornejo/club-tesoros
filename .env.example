# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/club-tesoros?retryWrites=true&w=majority

# NextAuth - Autenticación con Google
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-un-secret-seguro-con-openssl-rand-base64-32

# Google OAuth - Obtener de Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu-google-client-id-aqui
GOOGLE_CLIENT_SECRET=tu-google-client-secret-aqui

# Configuración de la aplicación
NEXT_PUBLIC_APP_NAME=Club Tesoros
NEXT_PUBLIC_APP_URL=http://localhost:3000
